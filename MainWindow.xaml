<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="StopwatchWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StopwatchWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Stopwatch Widget"
    mc:Ignorable="d">

    <!--
        The translucent "acrylic" material is set up in code-behind with a
        DesktopAcrylicController, so that its density can follow the slider in the app menu.
        On Windows versions without acrylic support the code falls back to a plain
        translucent panel.
    -->

    <!--
        Every row is content-sized on purpose: the window is resized to exactly this
        content, which is what lets the widget shrink to a slim strip while the command
        buttons are hidden.
    -->
    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The top strip doubles as the custom title bar: SetTitleBar(AppTitleBar) in
            code-behind turns it into the drag region for the window.
            The two buttons sit on the left because the system keeps its own minimise and
            close buttons in the top-right corner.
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="36">
            <StackPanel Margin="6,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="2">
                <!-- Hides or reveals the command panel; the glyph is swapped in code. -->
                <Button x:Name="CommandsToggleButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCommandsToggleClick"
                        CornerRadius="4">
                    <FontIcon x:Name="CommandsToggleIcon" FontSize="14" Glyph="&#xE70D;" />
                </Button>

                <Button x:Name="SettingsButton"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="4"
                        ToolTipService.ToolTip="Оформление">
                    <FontIcon FontSize="14" Glyph="&#xE713;" Opacity="0.8" />
                    <Button.Flyout>
                        <Flyout Placement="Bottom">
                            <!--
                                A flyout lives in its own popup, outside the window's visual
                                tree, so it does not inherit the data context; it is wired up
                                in code-behind.
                            -->
                            <StackPanel x:Name="SettingsPanel" Width="240" Spacing="10">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Оформление" />

                                <Slider x:Name="OpacitySlider"
                                        Header="Плотность подложки"
                                        Maximum="1"
                                        Minimum="0"
                                        StepFrequency="0.05"
                                        Value="{Binding BackgroundOpacity, Mode=TwoWay}" />

                                <TextBlock HorizontalAlignment="Right"
                                           Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="{Binding BackgroundOpacityLabel}" />

                                <TextBlock Opacity="0.7"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Text="Меньше — прозрачнее, больше — плотнее. Цифры всегда непрозрачны."
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Elapsed time, refreshed by the view model every 100 ms. Never translucent. -->
        <TextBlock Grid.Row="1"
                   Margin="12,2,12,6"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Consolas"
                   FontSize="52"
                   FontWeight="SemiBold"
                   IsTextSelectionEnabled="True"
                   Text="{Binding FormattedTime}" />

        <!-- Commands and the always-on-top toggle; hidden when the widget is collapsed. -->
        <StackPanel x:Name="CommandPanel"
                    Grid.Row="2"
                    Padding="16,4,16,14"
                    Spacing="12">
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button MinWidth="88" Command="{Binding StartCommand}" Content="Старт" />
                <Button MinWidth="88" Command="{Binding PauseCommand}" Content="Пауза" />
                <Button MinWidth="88" Command="{Binding ResetCommand}" Content="Сброс" />
            </StackPanel>

            <ToggleSwitch HorizontalAlignment="Center"
                          Header="Поверх всех окон"
                          IsOn="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</Window>
