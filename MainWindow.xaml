<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="StopwatchWidget.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:StopwatchWidget"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Stopwatch Widget"
    mc:Ignorable="d">

    <!--
        DesktopAcrylicBackdrop gives the window the translucent "acrylic" material.
        On Windows 10 this falls back to a solid colour automatically.
    -->
    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootLayout">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            The top strip doubles as the custom title bar. Because the window
            extends its content into the title bar area, calling
            SetTitleBar(AppTitleBar) in code-behind makes this whole strip act as
            the drag region (and it keeps the system caption buttons on the right).
        -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48">
            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Opacity="0.75"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Text="Stopwatch Widget" />
        </Grid>

        <!-- Elapsed time, refreshed by the view model every 100 ms. -->
        <TextBlock Grid.Row="1"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontFamily="Consolas"
                   FontSize="52"
                   FontWeight="SemiBold"
                   IsTextSelectionEnabled="True"
                   Text="{Binding FormattedTime}" />

        <!-- Commands and the always-on-top toggle. -->
        <StackPanel Grid.Row="2"
                    Padding="16,8,16,16"
                    Spacing="14">
            <StackPanel HorizontalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                <Button MinWidth="88" Command="{Binding StartCommand}" Content="Старт" />
                <Button MinWidth="88" Command="{Binding PauseCommand}" Content="Пауза" />
                <Button MinWidth="88" Command="{Binding ResetCommand}" Content="Сброс" />
            </StackPanel>

            <ToggleSwitch HorizontalAlignment="Center"
                          Header="Поверх всех окон"
                          IsOn="{Binding IsAlwaysOnTop, Mode=TwoWay}" />
        </StackPanel>
    </Grid>
</Window>
